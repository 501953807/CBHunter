{
  "manifest_version": 3,
  "name": "CBHunter 采集助手",
  "version": "0.3.0",
  "description": "一键采集 Shopee / TikTok Shop / TEMU / 1688 商品到 CBHunter 跨境电商管理系统",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.shopee.com.my/*",
    "https://*.shopee.ph/*",
    "https://*.shopee.sg/*",
    "https://*.shopee.co.th/*",
    "https://*.shopee.vn/*",
    "https://*.shopee.tw/*",
    "https://*.shopee.co.id/*",
    "https://*.shopee.com.br/*",
    "https://*.temu.com/*",
    "https://*.tiktok.com/*",
    "https://*.1688.com/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "CBHunter 采集助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.shopee.com.my/*",
        "https://*.shopee.ph/*",
        "https://*.shopee.sg/*",
        "https://*.shopee.co.th/*",
        "https://*.shopee.vn/*",
        "https://*.shopee.tw/*",
        "https://*.shopee.co.id/*",
        "https://*.shopee.com.br/*",
        "https://*.temu.com/*",
        "https://*.tiktok.com/*",
        "https://*.1688.com/*"
      ],
      "js": ["content/platforms.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
